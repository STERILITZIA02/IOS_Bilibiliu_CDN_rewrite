    {
      "key": "cdn",
      "argument": "CDN",
      "group": "network",
      "label": "CDN 模式",
      "description": "auto 只提升同一媒体路径、由服务器提供且后台验证合格的完整地址；无可靠证据时保留原主地址；不接管媒体重试或快进请求、不拼接主机；off 关闭 CDN 改写，固定主机也只使用本次响应已有候选",
      "type": "string",
      "default": "auto",
      "variants": ["cdn", "enhanced"]
    },
    {
      "key": "routingPolicy",
      "argument": "分流策略",
      "group": "network",
      "label": "Bilibili 分流策略",
      "description": "DIRECT、PROXY 或 Shadowrocket 中已有的策略组名称",
      "type": "string",
      "default": "DIRECT",
      "variants": ["cdn", "enhanced"]
    },
    {
      "key": "pcdnPolicy",
      "argument": "PCDN策略",
      "group": "network",
      "label": "PCDN 策略",
      "description": "默认 DIRECT；可选择 REJECT，海外回国分流时也可填写同一个策略组",
      "type": "string",
      "default": "DIRECT",
      "variants": ["cdn", "enhanced"]
    },
    {
      "key": "networkProfile",
      "argument": "网络档案",
      "group": "network",
      "label": "网络档案",
      "description": "auto 在运行时支持时区分 Wi-Fi/蜂窝并只保存稳定标识 hash，不支持时回落共享 auto；也可手动命名隔离网络",
      "type": "string",
      "default": "auto",
      "variants": ["cdn", "enhanced"]
    },
    {
      "key": "probeMode",
      "argument": "测速方式",
      "group": "network",
      "label": "测速执行方式",
      "description": "cron 在后台匿名比较原主线路与实际备用线路，分别学习音视频；收到播放信息后的三分钟暂停测速；旧 nonblocking 映射为 cron，blocking 仅诊断，off 停止学习并只使用仍有效的既有测速结果",
      "type": "string",
      "default": "cron",
      "variants": ["cdn", "enhanced"]
    },
    {
      "key": "resetToken",
      "argument": "重置令牌",
      "group": "network",
      "label": "CDN 学习状态",
      "description": "更改令牌会安全清空一次已学习 CDN 状态；相同令牌不会重复重置",
      "type": "string",
      "default": "none",
      "variants": ["cdn", "enhanced"]
    },
    {
      "key": "intervalHours",
      "argument": "测速间隔",
      "group": "network",
      "label": "后台测速间隔",
      "description": "稳定后每 2–72 小时测速；每十分钟检查一次是否到期，新网络首次最多六轮加快学习，之后遵守此间隔；近期播放时延后测速，初期测速会额外消耗流量；样本六小时有效",
      "type": "number",
      "default": 2,
      "minimum": 2,
      "maximum": 72,
      "variants": ["cdn", "enhanced"]
    },
    {
      "key": "switchThreshold",
      "argument": "切换阈值",
      "group": "network",
      "label": "切换阈值",
      "description": "当前线路健康时，挑战者的 TTFB/短段/持续吞吐综合分至少领先该百分比才切换；线路不健康时立即切换",
      "type": "number",
      "default": 20,
      "minimum": 10,
      "maximum": 80,
      "variants": ["cdn", "enhanced"]
    },
    {
      "key": "debug",
      "argument": "调试日志",
      "group": "network",
      "label": "调试日志",
      "description": "仅排错时开启；日志不记录完整媒体 URL、签名或响应正文",
      "type": "boolean",
      "default": false,
      "variants": ["cdn", "enhanced"]
    }
