  "options": [
    {
      "key": "ads",
      "argument": "广告过滤",
      "group": "features",
      "label": "广告过滤",
      "description": "移除明确广告与已审核商品模块；覆盖首页推广/魔力赏、动态综合/视频流、UP主分享好物、播放器下 Banner、倒计时/底部弹窗、DmView 商业指令、异步相关推荐、评论和直播商业容器；普通标题不参与判定，无网络请求的 App 内存恢复不在脚本控制范围内",
      "type": "boolean",
      "default": true,
      "variants": ["enhanced"]
    },
    {
      "key": "homeFeedVideoOnly",
      "argument": "首页推荐6个普通视频",
      "group": "features",
      "label": "首页推荐仅 6 个普通视频",
      "description": "广告过滤开启时，每次首页、推荐页和短视频流刷新最多保留 6 条普通 AV；默认立即显示已有视频，不为凑数等待网络补取；全广告或全非视频响应不会放回广告",
      "type": "boolean",
      "default": true,
      "variants": ["enhanced"]
    },
    {
      "key": "homeFeedRefill",
      "argument": "首页补齐6条",
      "group": "features",
      "label": "首页不足 6 条时补取",
      "description": "默认关闭以减少首页等待；开启后，在广告过滤和首页普通视频过滤均开启时，最多额外请求一次尝试补齐 6 条，可能增加约 2.45 秒等待；失败保留已有视频，不递归补取",
      "type": "boolean",
      "default": false,
      "variants": ["enhanced"]
    },
    {
      "key": "videoOnlyRecommendations",
      "argument": "推荐仅普通视频",
      "group": "features",
      "label": "播放页只保留普通视频",
      "description": "广告过滤开启时，首次进入播放页即清理播放器下广告及绑定按钮，推荐只保留协议中明确携带 AV 载荷的普通视频；移除番剧、综艺、纪录片、影视、直播、游戏、课程、活动、广告、商品卡和必火推荐等非视频卡片",
      "type": "boolean",
      "default": true,
      "variants": ["enhanced"]
    },
    {
      "key": "ui",
      "argument": "界面精简",
      "group": "features",
      "label": "界面逐项精简",
      "description": "启用下方首页、我的服务和更多服务的逐项隐藏设置",
      "type": "boolean",
      "default": true,
      "variants": ["enhanced"]
    },
    {
      "key": "searchPromotions",
      "argument": "搜索推广",
      "group": "features",
      "label": "搜索推广词",
      "description": "隐藏搜索页明确的运营推广词；搜索结果中的创作推广商业卡由广告过滤独立控制，关闭后原样保留运营词",
      "type": "boolean",
      "default": true,
      "variants": ["enhanced"]
    },
    {
      "key": "liveShopping",
      "argument": "直播带货",
      "group": "features",
      "label": "直播带货卡片",
      "description": "隐藏直播间明确的购物卡片与业务编号 33 的购物标签",
      "type": "boolean",
      "default": true,
      "variants": ["enhanced"]
