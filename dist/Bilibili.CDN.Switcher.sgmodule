#!name=Bilibili CDN Switcher
#!desc=仅包含保守 CDN 自动选择与视频、直播、API 分流；不改动页面内容或账号数据（iPhone / iPad）
#!version=3.7.0
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite
#!icon=https://i0.hdslb.com/bfs/static/jinkela/long/images/512.png
#!category=Bilibili
#!arguments=CDN:auto,分流策略:DIRECT,PCDN策略:DIRECT,网络档案:auto,测速方式:nonblocking,重置令牌:none,测速间隔:12,切换阈值:20,调试日志:false
#!arguments-desc=CDN：auto 只比较同一媒体对象的服务端完整候选；off 关闭；固定主机仅在本次响应已返回该完整 URL 时提升，否则不改写\n\n分流策略：DIRECT、PROXY 或 Shadowrocket 中已有的策略组名称\n\nPCDN策略：默认 DIRECT；可选择 REJECT，海外回国分流时也可填写同一个策略组\n\n网络档案：auto 只是共享缓存档案，不会自动识别 Wi-Fi、蜂窝或 SSID；手动命名可隔离不同网络\n\n测速方式：nonblocking 默认不阻塞首播；升级后可临时用 blocking 完成两次确定性学习，再恢复 nonblocking；off 只复用已验证缓存\n\n重置令牌：更改令牌会安全清空一次已学习 CDN 状态；相同令牌不会重复重置\n\n测速间隔：6 到 72 小时且与实际选择 TTL 完全一致；已选线路最多每 8 分钟非阻塞复核一次，所有探测仍有至少 2 分钟全局间隔\n\n切换阈值：备用线路的文件内部 1 MiB 复核吞吐达到表示余量后，至少高多少百分比才完成第二次确认\n\n调试日志：仅排错时开启；日志不记录完整媒体 URL、签名或响应正文

[Rule]
DOMAIN-WILDCARD,*pcdn*.biliapi.net,{{{PCDN策略}}}
RULE-SET,https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/Bilibili.list?v=3.7.0,{{{分流策略}}}

[Script]
Bilibili Story Safe Pipeline = type=http-response,pattern=^https?:\/\/(?:app\.bilibili\.com|app\.biliapi\.net)\/x\/v2\/feed\/index\/story(?:\/cart)?(?:\?|$),requires-body=1,max-size=4194304,timeout=10,engine=jsc,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-story-cdn.js?v=3.7.0,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}},"enhanceStory":false}"
Bilibili CDN JSON = type=http-response,pattern=^https?:\/\/(?:(?:api|app)\.(?:bilibili\.com|biliapi\.net)|interface\.bilibili\.com)\/(?:x\/(?:player\/(?:wbi\/)?playurl(?:v2)?|v2\/playurl)|pgc\/player\/(?:api\/playurl(?:proj)?|web\/(?:v2\/)?playurl(?:\/html5)?)|pugv\/player\/(?:api|web)\/playurl|v2\/playurl)(?:\?|$),requires-body=1,max-size=4194304,timeout=10,engine=jsc,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-cdn.js?v=3.7.0,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}}}"
Bilibili CDN gRPC = type=http-response,pattern=^https?:\/\/(?:(?:grpc|app)\.(?:bilibili\.com|biliapi\.net))\/(?:bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite|bilibili\.app\.playurl\.v1\.PlayURL\/PlayView|bilibili\.(?:pgc\.gateway\.player\.(?:v1|v2)|cheese\.gateway\.player\.v1)\.PlayURL\/PlayView)(?:\?|$),requires-body=1,binary-body-mode=1,max-size=4194304,timeout=10,engine=webview,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-cdn.js?v=3.7.0,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}}}"

[MITM]
h2 = true
hostname = %APPEND% api.bilibili.com, app.bilibili.com, interface.bilibili.com, api.biliapi.net, app.biliapi.net, grpc.bilibili.com, grpc.biliapi.net
