#!name=Bilibili CDN Switcher
#!desc=仅包含保守 CDN 自动选择与视频、直播、API 分流；不改动页面内容或账号数据（iPhone / iPad）
#!version=3.8.2
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite
#!icon=https://i0.hdslb.com/bfs/static/jinkela/long/images/512.png
#!category=Bilibili
#!arguments=CDN:auto,分流策略:DIRECT,PCDN策略:DIRECT,网络档案:auto,测速方式:cron,重置令牌:none,测速间隔:2,切换阈值:20,调试日志:false
#!arguments-desc=CDN：auto 播放热路径零测速：优先后台验证的稳定主机，无状态时直接提升服务端完整 Akamai URL；off 关闭 CDN 改写；固定主机仍只提升本次响应已有的完整 URL\n\n分流策略：DIRECT、PROXY 或 Shadowrocket 中已有的策略组名称\n\nPCDN策略：默认 DIRECT；可选择 REJECT，海外回国分流时也可填写同一个策略组\n\n网络档案：auto 只是共享缓存档案，不会自动识别 Wi-Fi、蜂窝或 SSID；手动命名可隔离不同网络\n\n测速方式：cron 默认每两小时在独立后台脚本中匿名测速，播放、拖动与倍速响应不发测速请求；旧 nonblocking 自动映射为 cron；blocking 仅用于显式诊断；off 停止后台学习但保留完整 Akamai 冷启动回退\n\n重置令牌：更改令牌会安全清空一次已学习 CDN 状态；相同令牌不会重复重置\n\n测速间隔：2 到 72 小时；cron 每两小时唤醒并仅在达到此间隔时测速，主机 alias 成功样本 6 小时有效，超过 24 小时只使用冷启动规则\n\n切换阈值：仅供 blocking 诊断兼容；默认 cron 使用 p25 吞吐、失败率、抖动和两个不同对象的稳定评分\n\n调试日志：仅排错时开启；日志不记录完整媒体 URL、签名或响应正文

[Rule]
DOMAIN-WILDCARD,*pcdn*.biliapi.net,{{{PCDN策略}}}
RULE-SET,https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/Bilibili.list?v=3.8.2,{{{分流策略}}}

[Script]
Bilibili CDN Background Benchmark = type=cron,cronexp=0 17 */2 * * *,wake-system=1,timeout=45,engine=webview,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-cdn-benchmark.js?v=3.8.2,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"debug":{{{调试日志}}}}"
Bilibili Story Safe Pipeline = type=http-response,pattern=^https?:\/\/(?:app\.bilibili\.com|app\.biliapi\.net)\/x\/v2\/feed\/index\/(?:story(?:\/cart)?|relate\/story)(?:\?|$),requires-body=1,max-size=4194304,timeout=10,engine=jsc,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-story-cdn.js?v=3.8.2,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}},"enhanceStory":false}"
Bilibili CDN Cached Media Route = type=http-request,pattern=^https?:\/\/(?:(?:[a-z0-9-]+\.)+(?:acgvideo\.com|bilivideo\.com|bilivideo\.cn|bilivideo\.net|bilibilivideo\.com|ourdvsss\.com|ksyungslb\.com|00cdn\.com)|upos-[a-z0-9-]+\.akamaized\.net|uposdash-[a-z0-9-]+\.yfcdn\.net)(?::\d+)?\/upgcxcode\/,requires-body=0,timeout=2,engine=jsc,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-cdn-route.js?v=3.8.2,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}}}"
Bilibili CDN JSON = type=http-response,pattern=^https?:\/\/(?:(?:api|app)\.(?:bilibili\.com|biliapi\.net)|interface\.bilibili\.com)\/(?:x\/(?:player\/(?:wbi\/)?playurl(?:v2)?|v2\/playurl)|pgc\/player\/(?:api\/playurl(?:proj)?|web\/(?:v2\/)?playurl(?:\/html5)?)|pugv\/player\/(?:api|web)\/playurl|v2\/playurl)(?:\?|$),requires-body=1,max-size=4194304,timeout=10,engine=jsc,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-cdn.js?v=3.8.2,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}}}"
Bilibili CDN gRPC = type=http-response,pattern=^https?:\/\/(?:(?:grpc|app)\.(?:bilibili\.com|biliapi\.net))\/(?:bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite|bilibili\.app\.playurl\.v1\.PlayURL\/PlayView|bilibili\.(?:pgc\.gateway\.player\.(?:v1|v2)|cheese\.gateway\.player\.v1)\.PlayURL\/PlayView)(?:\?|$),requires-body=1,binary-body-mode=1,max-size=4194304,timeout=10,engine=webview,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-cdn.js?v=3.8.2,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}}}"

[MITM]
h2 = true
hostname = %APPEND% api.bilibili.com, app.bilibili.com, interface.bilibili.com, api.biliapi.net, app.biliapi.net, grpc.bilibili.com, grpc.biliapi.net
