#!name=Bilibili CDN Enhanced
#!desc=CDN 自动选择 + 广告过滤 + 首页六条普通视频流 + 播放页普通视频推荐白名单 + 首页/我的逐项精简；不修改账号、会员、订单与付费权益（iPhone / iPad）
#!version=3.8.0
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite
#!icon=https://i0.hdslb.com/bfs/static/jinkela/long/images/512.png
#!category=Bilibili
#!arguments=广告过滤:true,首页推荐6个普通视频:true,推荐仅普通视频:true,界面精简:true,搜索推广:true,直播带货:true,会员营销:true,隐藏首页游戏中心:true,隐藏新征程频道:true,隐藏底部发布:true,隐藏底部会员购:true,隐藏首次投稿:true,隐藏有奖发布:true,隐藏我的课程:true,隐藏免流量:true,隐藏工房:true,隐藏能量加油站:true,隐藏BW乐园:true,隐藏B萌投票:true,隐藏个性装扮:false,隐藏我的钱包:false,隐藏我的游戏中心:false,隐藏会员购订单:false,隐藏我的直播:false,隐藏必火推广:false,隐藏创作中心:false,隐藏社区中心:false,隐藏联系客服:false,隐藏听视频:false,隐藏未成年人守护:false,隐藏设置:false,CDN:auto,分流策略:DIRECT,PCDN策略:DIRECT,网络档案:auto,测速方式:cron,重置令牌:none,测速间隔:2,切换阈值:20,调试日志:false
#!arguments-desc=广告过滤：仅移除具有明确广告字段或多项商业特征的卡片；播放页推荐另受普通视频白名单控制\n\n首页推荐6个普通视频：广告过滤开启时，每次首页、推荐页和短视频流刷新都只接受明确的普通 AV 视频；首份首页响应不足 6 条时最多无缓存补取一次，仍不足则保留实际数量，不复制旧卡\n\n推荐仅普通视频：广告过滤开启时，首次进入播放页即清理播放器下广告，推荐只保留协议中明确携带 AV 载荷的普通视频；移除番剧、综艺、纪录片、影视、直播、游戏、课程、活动、广告和必火推荐等非视频卡片\n\n界面精简：启用下方首页、我的服务和更多服务的逐项隐藏设置\n\n搜索推广：隐藏搜索页明确的运营推广词，关闭后原样保留\n\n直播带货：隐藏直播间明确的购物卡片与业务编号 33 的购物标签\n\n会员营销：隐藏我的页和大会员中心的营销横幅，不修改会员状态、到期时间、钱包或订单\n\n隐藏首页游戏中心：默认隐藏；消息入口、红点、搜索框和头像始终保留\n\n隐藏新征程频道：默认隐藏；其他普通频道和未知新频道保留\n\n隐藏底部发布：默认隐藏并重新连续排列底栏位置\n\n隐藏底部会员购：默认隐藏；首页、关注和我的底栏始终保留\n\n隐藏首次投稿：默认隐藏\n\n隐藏有奖发布：默认隐藏\n\n隐藏我的课程：默认隐藏\n\n隐藏免流量：默认隐藏\n\n隐藏工房：默认隐藏\n\n隐藏能量加油站：默认隐藏\n\n隐藏BW乐园：默认隐藏\n\n隐藏B萌投票：默认隐藏\n\n隐藏个性装扮：默认显示\n\n隐藏我的钱包：默认显示\n\n隐藏我的游戏中心：默认显示\n\n隐藏会员购订单：默认显示\n\n隐藏我的直播：默认显示\n\n隐藏必火推广：默认显示\n\n隐藏创作中心：默认显示\n\n隐藏社区中心：默认显示\n\n隐藏联系客服：默认显示\n\n隐藏听视频：默认显示\n\n隐藏未成年人守护：默认显示\n\n隐藏设置：默认显示\n\nCDN：auto 播放热路径零测速：优先后台验证的稳定主机，无状态时直接提升服务端完整 Akamai URL；off 关闭 CDN 改写；固定主机仍只提升本次响应已有的完整 URL\n\n分流策略：DIRECT、PROXY 或 Shadowrocket 中已有的策略组名称\n\nPCDN策略：默认 DIRECT；可选择 REJECT，海外回国分流时也可填写同一个策略组\n\n网络档案：auto 只是共享缓存档案，不会自动识别 Wi-Fi、蜂窝或 SSID；手动命名可隔离不同网络\n\n测速方式：cron 默认每两小时在独立后台脚本中匿名测速，播放、拖动与倍速响应不发测速请求；旧 nonblocking 自动映射为 cron；blocking 仅用于显式诊断；off 停止后台学习但保留完整 Akamai 冷启动回退\n\n重置令牌：更改令牌会安全清空一次已学习 CDN 状态；相同令牌不会重复重置\n\n测速间隔：2 到 72 小时；cron 每两小时唤醒并仅在达到此间隔时测速，主机 alias 成功样本 6 小时有效，超过 24 小时只使用冷启动规则\n\n切换阈值：仅供 blocking 诊断兼容；默认 cron 使用 p25 吞吐、失败率、抖动和两个不同对象的稳定评分\n\n调试日志：仅排错时开启；日志不记录完整媒体 URL、签名或响应正文

[Rule]
DOMAIN-WILDCARD,*pcdn*.biliapi.net,{{{PCDN策略}}}
RULE-SET,https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/Bilibili.list?v=3.8.0,{{{分流策略}}}

[Script]
Bilibili CDN Background Benchmark = type=cron,cronexp=0 17 */2 * * *,wake-system=1,timeout=45,engine=webview,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-cdn-benchmark.js?v=3.8.0,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"debug":{{{调试日志}}}}"
Bilibili Enhance Fresh UI = type=http-request,pattern=^https?:\/\/(?:(?:app\.bilibili\.com|app\.biliapi\.net)\/(?:x\/v2\/(?:splash\/(?:brand\/list|event\/list2|list|show)|feed\/index(?:\/(?:story(?:\/cart)?|relate\/story))?|view|account\/(?:mine(?:\/ipad)?|myinfo))|x\/vip\/ads\/(?:materials|material\/report))|(?:api\.bilibili\.com|api\.biliapi\.net)\/x\/vip\/ads\/(?:materials|material\/report)|api\.vc\.bilibili\.com\/search_svr\/v\d+\/Search\/recommend_words|manga\.bilibili\.com\/twirp\/comic\.v\d+\.Comic\/(?:Flash|ListFlash))(?:\?|$),timeout=3,engine=jsc,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-refresh.js?v=3.8.0,argument="{"debug":{{{调试日志}}}}"
Bilibili Enhance JSON = type=http-response,pattern=^https?:\/\/(?:(?:app\.bilibili\.com|app\.biliapi\.net)\/(?:x\/v2\/(?:splash\/(?:brand\/list|event\/list2|list|show)|feed\/index|search(?:\/square|\/type)?|view|account\/(?:mine(?:\/ipad)?|myinfo))|x\/(?:resource\/(?:show\/tab\/v2|top\/activity|patch\/tab(?:\/v2)?)|vip\/ads\/(?:materials|material\/report)))|(?:api\.bilibili\.com|api\.biliapi\.net)\/(?:pgc\/(?:page\/(?:bangumi|cinema\/tab)|activity\/deliver\/material\/receive)|x\/(?:resource\/(?:top\/activity|patch\/tab(?:\/v2)?)|vip\/(?:web\/vip_center\/combine|ads\/(?:materials|material\/report))|web-interface\/(?:wbi\/)?index\/top\/feed\/rcmd|v2\/reply\/main))|api\.live\.bilibili\.com\/xlive\/(?:app-room\/v1\/index\/getInfoByRoom|e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info)|line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material|api\.vc\.bilibili\.com\/search_svr\/v\d+\/Search\/recommend_words|manga\.bilibili\.com\/twirp\/comic\.v\d+\.Comic\/(?:Flash|ListFlash))(?:\?|$),requires-body=1,max-size=4194304,timeout=8,engine=jsc,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-enhance.js?v=3.8.0,argument="{"ads":{{{广告过滤}}},"homeFeedVideoOnly":{{{首页推荐6个普通视频}}},"videoOnlyRecommendations":{{{推荐仅普通视频}}},"ui":{{{界面精简}}},"searchPromotions":{{{搜索推广}}},"liveShopping":{{{直播带货}}},"vipPromotions":{{{会员营销}}},"hideHomeGame":{{{隐藏首页游戏中心}}},"hideHomeJourney":{{{隐藏新征程频道}}},"hideBottomPublish":{{{隐藏底部发布}}},"hideBottomMall":{{{隐藏底部会员购}}},"hideMineFirstVideo":{{{隐藏首次投稿}}},"hideMineRewardPublish":{{{隐藏有奖发布}}},"hideMineCourse":{{{隐藏我的课程}}},"hideMineFreeData":{{{隐藏免流量}}},"hideMineWorkshop":{{{隐藏工房}}},"hideMineEnergy":{{{隐藏能量加油站}}},"hideMineBwPark":{{{隐藏BW乐园}}},"hideMineBmoe":{{{隐藏B萌投票}}},"hideMinePersonalDress":{{{隐藏个性装扮}}},"hideMineWallet":{{{隐藏我的钱包}}},"hideMineGameCenter":{{{隐藏我的游戏中心}}},"hideMineMallOrders":{{{隐藏会员购订单}}},"hideMineLive":{{{隐藏我的直播}}},"hideMinePromotion":{{{隐藏必火推广}}},"hideMineCreatorCenter":{{{隐藏创作中心}}},"hideMineCommunityCenter":{{{隐藏社区中心}}},"hideMoreCustomerService":{{{隐藏联系客服}}},"hideMoreListenVideo":{{{隐藏听视频}}},"hideMoreTeenProtection":{{{隐藏未成年人守护}}},"hideMoreSettings":{{{隐藏设置}}},"debug":{{{调试日志}}}}"
Bilibili Enhance gRPC = type=http-response,pattern=^https?:\/\/(?:(?:grpc|app)\.bilibili\.com|(?:grpc|app)\.biliapi\.net)\/(?:bilibili\.app\.(?:view\.v1\.View\/(?:View|ViewProgress|RelatesFeed|TFInfo)|viewunite\.v1\.View\/(?:View|ViewProgress|PlayPause|ViewEndPage|RelatesFeed)|mine\.v1\.Mine\/(?:PubModule|DeviceFeature)|resource\.v1\.Module\/List|show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|interface\.v1\.Search\/DefaultWords)|bilibili\.polymer\.app\.search\.v1\.Search\/(?:SearchAll|SearchByType)|bilibili\.main\.community\.reply\.v1\.Reply\/MainList)(?:\?|$),requires-body=1,binary-body-mode=1,max-size=4194304,timeout=10,engine=webview,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-enhance.js?v=3.8.0,argument="{"ads":{{{广告过滤}}},"homeFeedVideoOnly":{{{首页推荐6个普通视频}}},"videoOnlyRecommendations":{{{推荐仅普通视频}}},"ui":{{{界面精简}}},"searchPromotions":{{{搜索推广}}},"liveShopping":{{{直播带货}}},"vipPromotions":{{{会员营销}}},"hideHomeGame":{{{隐藏首页游戏中心}}},"hideHomeJourney":{{{隐藏新征程频道}}},"hideBottomPublish":{{{隐藏底部发布}}},"hideBottomMall":{{{隐藏底部会员购}}},"hideMineFirstVideo":{{{隐藏首次投稿}}},"hideMineRewardPublish":{{{隐藏有奖发布}}},"hideMineCourse":{{{隐藏我的课程}}},"hideMineFreeData":{{{隐藏免流量}}},"hideMineWorkshop":{{{隐藏工房}}},"hideMineEnergy":{{{隐藏能量加油站}}},"hideMineBwPark":{{{隐藏BW乐园}}},"hideMineBmoe":{{{隐藏B萌投票}}},"hideMinePersonalDress":{{{隐藏个性装扮}}},"hideMineWallet":{{{隐藏我的钱包}}},"hideMineGameCenter":{{{隐藏我的游戏中心}}},"hideMineMallOrders":{{{隐藏会员购订单}}},"hideMineLive":{{{隐藏我的直播}}},"hideMinePromotion":{{{隐藏必火推广}}},"hideMineCreatorCenter":{{{隐藏创作中心}}},"hideMineCommunityCenter":{{{隐藏社区中心}}},"hideMoreCustomerService":{{{隐藏联系客服}}},"hideMoreListenVideo":{{{隐藏听视频}}},"hideMoreTeenProtection":{{{隐藏未成年人守护}}},"hideMoreSettings":{{{隐藏设置}}},"debug":{{{调试日志}}}}"
Bilibili Story Safe Pipeline = type=http-response,pattern=^https?:\/\/(?:app\.bilibili\.com|app\.biliapi\.net)\/x\/v2\/feed\/index\/(?:story(?:\/cart)?|relate\/story)(?:\?|$),requires-body=1,max-size=4194304,timeout=10,engine=jsc,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-story.js?v=3.8.0,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}},"ads":{{{广告过滤}}},"homeFeedVideoOnly":{{{首页推荐6个普通视频}}},"videoOnlyRecommendations":{{{推荐仅普通视频}}},"ui":{{{界面精简}}},"searchPromotions":{{{搜索推广}}},"liveShopping":{{{直播带货}}},"vipPromotions":{{{会员营销}}},"hideHomeGame":{{{隐藏首页游戏中心}}},"hideHomeJourney":{{{隐藏新征程频道}}},"hideBottomPublish":{{{隐藏底部发布}}},"hideBottomMall":{{{隐藏底部会员购}}},"hideMineFirstVideo":{{{隐藏首次投稿}}},"hideMineRewardPublish":{{{隐藏有奖发布}}},"hideMineCourse":{{{隐藏我的课程}}},"hideMineFreeData":{{{隐藏免流量}}},"hideMineWorkshop":{{{隐藏工房}}},"hideMineEnergy":{{{隐藏能量加油站}}},"hideMineBwPark":{{{隐藏BW乐园}}},"hideMineBmoe":{{{隐藏B萌投票}}},"hideMinePersonalDress":{{{隐藏个性装扮}}},"hideMineWallet":{{{隐藏我的钱包}}},"hideMineGameCenter":{{{隐藏我的游戏中心}}},"hideMineMallOrders":{{{隐藏会员购订单}}},"hideMineLive":{{{隐藏我的直播}}},"hideMinePromotion":{{{隐藏必火推广}}},"hideMineCreatorCenter":{{{隐藏创作中心}}},"hideMineCommunityCenter":{{{隐藏社区中心}}},"hideMoreCustomerService":{{{隐藏联系客服}}},"hideMoreListenVideo":{{{隐藏听视频}}},"hideMoreTeenProtection":{{{隐藏未成年人守护}}},"hideMoreSettings":{{{隐藏设置}}},"enhanceStory":true}"
Bilibili CDN JSON = type=http-response,pattern=^https?:\/\/(?:(?:api|app)\.(?:bilibili\.com|biliapi\.net)|interface\.bilibili\.com)\/(?:x\/(?:player\/(?:wbi\/)?playurl(?:v2)?|v2\/playurl)|pgc\/player\/(?:api\/playurl(?:proj)?|web\/(?:v2\/)?playurl(?:\/html5)?)|pugv\/player\/(?:api|web)\/playurl|v2\/playurl)(?:\?|$),requires-body=1,max-size=4194304,timeout=10,engine=jsc,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-cdn.js?v=3.8.0,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}}}"
Bilibili CDN gRPC = type=http-response,pattern=^https?:\/\/(?:(?:grpc|app)\.(?:bilibili\.com|biliapi\.net))\/(?:bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite|bilibili\.app\.playurl\.v1\.PlayURL\/PlayView|bilibili\.(?:pgc\.gateway\.player\.(?:v1|v2)|cheese\.gateway\.player\.v1)\.PlayURL\/PlayView)(?:\?|$),requires-body=1,binary-body-mode=1,max-size=4194304,timeout=10,engine=webview,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-cdn.js?v=3.8.0,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}}}"

[MITM]
h2 = true
hostname = %APPEND% api.bilibili.com, app.bilibili.com, interface.bilibili.com, api.biliapi.net, app.biliapi.net, grpc.bilibili.com, grpc.biliapi.net, api.live.bilibili.com, line3-h5-mobile-api.biligame.com, api.vc.bilibili.com, manga.bilibili.com
