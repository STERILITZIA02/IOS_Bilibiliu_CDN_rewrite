#!name=Bilibili CDN Enhanced
#!desc=CDN 自动选择 + 广告过滤 + 首页六条普通视频流 + 播放页普通视频推荐白名单 + 首页/我的逐项精简；不修改账号、会员、订单与付费权益（iPhone / iPad）
#!version=3.9.0
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite
#!icon=https://i0.hdslb.com/bfs/static/jinkela/long/images/512.png
#!category=Bilibili
#!arguments=广告过滤:true,首页推荐6个普通视频:true,推荐仅普通视频:true,界面精简:true,搜索推广:true,直播带货:true,会员营销:true,隐藏首页游戏中心:true,隐藏新征程频道:true,隐藏底部发布:true,隐藏底部会员购:true,隐藏首次投稿:true,隐藏有奖发布:true,隐藏我的课程:true,隐藏免流量:true,隐藏工房:true,隐藏能量加油站:true,隐藏BW乐园:true,隐藏B萌投票:true,隐藏个性装扮:false,隐藏我的钱包:false,隐藏我的游戏中心:false,隐藏会员购订单:false,隐藏我的直播:false,隐藏必火推广:false,隐藏创作中心:false,隐藏社区中心:false,隐藏联系客服:false,隐藏听视频:false,隐藏未成年人守护:false,隐藏设置:false,CDN:auto,分流策略:DIRECT,PCDN策略:DIRECT,网络档案:auto,测速方式:cron,重置令牌:none,测速间隔:2,切换阈值:20,调试日志:false
#!arguments-desc=广告过滤：仅移除具有明确广告字段或多项商业特征的卡片；播放页推荐另受普通视频白名单控制\n\n首页推荐6个普通视频：广告过滤开启时，每次首页、推荐页和短视频流刷新都只接受明确的普通 AV 视频；首份首页响应不足 6 条时最多无缓存补取一次，仍不足则保留实际数量，不复制旧卡\n\n推荐仅普通视频：广告过滤开启时，首次进入播放页即清理播放器下广告，推荐只保留协议中明确携带 AV 载荷的普通视频；移除番剧、综艺、纪录片、影视、直播、游戏、课程、活动、广告和必火推荐等非视频卡片\n\n界面精简：启用下方首页、我的服务和更多服务的逐项隐藏设置\n\n搜索推广：隐藏搜索页明确的运营推广词，关闭后原样保留\n\n直播带货：隐藏直播间明确的购物卡片与业务编号 33 的购物标签\n\n会员营销：隐藏我的页和大会员中心的营销横幅，不修改会员状态、到期时间、钱包或订单\n\n隐藏首页游戏中心：默认隐藏；消息入口、红点、搜索框和头像始终保留\n\n隐藏新征程频道：默认隐藏；其他普通频道和未知新频道保留\n\n隐藏底部发布：默认隐藏并重新连续排列底栏位置\n\n隐藏底部会员购：默认隐藏；首页、关注和我的底栏始终保留\n\n隐藏首次投稿：默认隐藏\n\n隐藏有奖发布：默认隐藏\n\n隐藏我的课程：默认隐藏\n\n隐藏免流量：默认隐藏\n\n隐藏工房：默认隐藏\n\n隐藏能量加油站：默认隐藏\n\n隐藏BW乐园：默认隐藏\n\n隐藏B萌投票：默认隐藏\n\n隐藏个性装扮：默认显示\n\n隐藏我的钱包：默认显示\n\n隐藏我的游戏中心：默认显示\n\n隐藏会员购订单：默认显示\n\n隐藏我的直播：默认显示\n\n隐藏必火推广：默认显示\n\n隐藏创作中心：默认显示\n\n隐藏社区中心：默认显示\n\n隐藏联系客服：默认显示\n\n隐藏听视频：默认显示\n\n隐藏未成年人守护：默认显示\n\n隐藏设置：默认显示\n\nCDN：auto 播放热路径零测速：优先后台验证的稳定主机，无状态时直接提升服务端完整 Akamai URL；off 关闭 CDN 改写；固定主机仍只提升本次响应已有的完整 URL\n\n分流策略：DIRECT、PROXY 或 Shadowrocket 中已有的策略组名称\n\nPCDN策略：默认 DIRECT；可选择 REJECT，海外回国分流时也可填写同一个策略组\n\n网络档案：auto 在运行时支持时区分 Wi-Fi/蜂窝并只保存稳定标识 hash，不支持时回落共享 auto；也可手动命名隔离网络\n\n测速方式：cron 默认每两小时在独立后台脚本中匿名测速，播放、拖动与倍速响应不发测速请求；旧 nonblocking 自动映射为 cron；blocking 仅用于显式诊断；off 停止后台学习但保留完整 Akamai 冷启动回退\n\n重置令牌：更改令牌会安全清空一次已学习 CDN 状态；相同令牌不会重复重置\n\n测速间隔：2 到 72 小时；cron 每两小时唤醒并仅在达到此间隔时测速，主机 alias 成功样本 6 小时有效，超过 24 小时只使用冷启动规则\n\n切换阈值：当前线路健康时，挑战者的 TTFB/短段/持续吞吐综合分至少领先该百分比才切换；线路不健康时立即切换\n\n调试日志：仅排错时开启；日志不记录完整媒体 URL、签名或响应正文

[Rule]
DOMAIN-WILDCARD,*pcdn*.biliapi.net,{{{PCDN策略}}}
RULE-SET,https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/Bilibili.list?v=3.9.0,{{{分流策略}}}

[Script]
Bilibili CDN Background Benchmark = type=cron,cronexp=0 17 */2 * * *,wake-system=1,timeout=45,engine=webview,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-cdn-benchmark.js?v=3.9.0,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}}}"
Bilibili Enhance Fresh UI = type=http-request,pattern=^https?:\/\/(?:(?:(?:app\.bilibili\.com|app\.biliapi\.net|api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/vip\/ads\/materials)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/vip\/ads\/material\/report)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/resource\/(?:top\/activity|patch\/tab(?:\/v2)?))|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/list)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/show)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/event\/list2)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/brand\/list)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/feed\/index)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/feed\/index\/story)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/feed\/index\/story\/cart)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/feed\/index\/relate\/story)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/search\/square)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/search(?:\/type)?)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/resource\/show\/tab\/v2)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/account\/mine(?:\/ipad)?)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/account\/myinfo)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/view)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/pgc\/page\/(?:bangumi|cinema\/tab))|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/web-interface\/(?:wbi\/)?index\/top\/feed\/rcmd)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/v2\/reply\/main)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/vip\/web\/vip_center\/combine)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/pgc\/activity\/deliver\/material\/receive)|(?:(?:api\.live\.bilibili\.com)(?::\d+)?\/xlive\/app-room\/v1\/index\/getInfoByRoom)|(?:(?:api\.live\.bilibili\.com)(?::\d+)?\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info)|(?:(?:line3-h5-mobile-api\.biligame\.com)(?::\d+)?\/game\/live\/large_card_material)|(?:(?:api\.vc\.bilibili\.com)(?::\d+)?\/search_svr\/v\d+\/Search\/recommend_words)|(?:(?:manga\.bilibili\.com)(?::\d+)?\/twirp\/comic\.v\d+\.Comic\/(?:Flash|ListFlash))|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.view\.v1\.View\/View)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.view\.v1\.View\/ViewProgress)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.view\.v1\.View\/RelatesFeed)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.view\.v1\.View\/TFInfo)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.viewunite\.v1\.View\/View)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.viewunite\.v1\.View\/ViewProgress)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.viewunite\.v1\.View\/PlayPause)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.viewunite\.v1\.View\/ViewEndPage)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.viewunite\.v1\.View\/RelatesFeed)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.mine\.v1\.Mine\/PubModule)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.mine\.v1\.Mine\/DeviceFeature)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.resource\.v1\.Module\/List)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.show\.v1\.Popular\/Index)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchByType)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.interface\.v1\.Search\/DefaultWords)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.story\.v1\.Story\/BottomDiversionEntrance)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.(?:view|viewunite|show|story|home|card|feed)\.[A-Za-z0-9_.]+\/[A-Za-z0-9_]+))(?:\?|$),timeout=3,engine=jsc,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-refresh.js?v=3.9.0,argument="{"debug":{{{调试日志}}}}"
Bilibili Enhance JSON = type=http-response,pattern=^https?:\/\/(?:(?:(?:app\.bilibili\.com|app\.biliapi\.net|api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/vip\/ads\/materials)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/vip\/ads\/material\/report)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/resource\/(?:top\/activity|patch\/tab(?:\/v2)?))|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/list)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/show)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/event\/list2)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/brand\/list)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/feed\/index)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/search\/square)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/search(?:\/type)?)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/resource\/show\/tab\/v2)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/account\/mine(?:\/ipad)?)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/account\/myinfo)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/view)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/pgc\/page\/(?:bangumi|cinema\/tab))|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/web-interface\/(?:wbi\/)?index\/top\/feed\/rcmd)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/v2\/reply\/main)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/vip\/web\/vip_center\/combine)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/pgc\/activity\/deliver\/material\/receive)|(?:(?:api\.live\.bilibili\.com)(?::\d+)?\/xlive\/app-room\/v1\/index\/getInfoByRoom)|(?:(?:api\.live\.bilibili\.com)(?::\d+)?\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info)|(?:(?:line3-h5-mobile-api\.biligame\.com)(?: