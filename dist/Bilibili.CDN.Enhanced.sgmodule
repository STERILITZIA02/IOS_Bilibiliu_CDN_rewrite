#!name=Bilibili CDN Enhanced
#!desc=CDN 自动选择 + 广告过滤 + 首页六条普通视频流 + 播放页普通视频推荐白名单 + 首页/我的逐项精简；不修改账号、会员、订单与付费权益（iPhone / iPad）
#!version=3.13.0
#!author=STERILITZIA02
#!homepage=https://github.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite
#!icon=https://i0.hdslb.com/bfs/static/jinkela/long/images/512.png
#!category=Bilibili
#!arguments=广告过滤:true,首页推荐6个普通视频:true,首页补齐6条:false,推荐仅普通视频:true,界面精简:true,搜索推广:true,直播带货:true,会员营销:true,隐藏首页游戏中心:true,隐藏新征程频道:true,隐藏底部发布:true,隐藏底部会员购:true,隐藏首次投稿:true,隐藏有奖发布:true,隐藏我的课程:true,隐藏免流量:true,隐藏工房:true,隐藏能量加油站:true,隐藏BW乐园:true,隐藏B萌投票:true,隐藏个性装扮:false,隐藏我的钱包:false,隐藏我的游戏中心:false,隐藏会员购订单:false,隐藏我的直播:false,隐藏必火推广:false,隐藏创作中心:false,隐藏社区中心:false,隐藏联系客服:false,隐藏听视频:false,隐藏未成年人守护:false,隐藏设置:false,CDN:auto,分流策略:DIRECT,PCDN策略:DIRECT,网络档案:auto,测速方式:cron,重置令牌:none,测速间隔:2,切换阈值:20,调试日志:false
#!arguments-desc=广告过滤：移除明确广告与已审核商品模块；覆盖首页推广/魔力赏、动态综合/视频流、UP主分享好物、播放器下 Banner、倒计时/底部弹窗、DmView 商业指令、异步相关推荐、评论和直播商业容器；普通标题不参与判定，无网络请求的 App 内存恢复不在脚本控制范围内\n\n首页推荐6个普通视频：广告过滤开启时，每次首页、推荐页和短视频流刷新最多保留 6 条普通 AV；默认立即显示已有视频，不为凑数等待网络补取；全广告或全非视频响应不会放回广告\n\n首页补齐6条：默认关闭以减少首页等待；开启后，在广告过滤和首页普通视频过滤均开启时，最多额外请求一次尝试补齐 6 条，可能增加约 2.45 秒等待；失败保留已有视频，不递归补取\n\n推荐仅普通视频：广告过滤开启时，首次进入播放页即清理播放器下广告及绑定按钮，推荐只保留协议中明确携带 AV 载荷的普通视频；移除番剧、综艺、纪录片、影视、直播、游戏、课程、活动、广告、商品卡和必火推荐等非视频卡片\n\n界面精简：启用下方首页、我的服务和更多服务的逐项隐藏设置\n\n搜索推广：隐藏搜索页明确的运营推广词；搜索结果中的创作推广商业卡由广告过滤独立控制，关闭后原样保留运营词\n\n直播带货：隐藏直播间明确的购物卡片与业务编号 33 的购物标签\n\n会员营销：隐藏我的页和大会员中心的营销横幅，不修改会员状态、到期时间、钱包或订单\n\n隐藏首页游戏中心：默认隐藏；消息入口、红点、搜索框和头像始终保留\n\n隐藏新征程频道：默认隐藏；其他普通频道和未知新频道保留\n\n隐藏底部发布：默认隐藏并重新连续排列底栏位置\n\n隐藏底部会员购：默认隐藏；首页、关注和我的底栏始终保留\n\n隐藏首次投稿：默认隐藏\n\n隐藏有奖发布：默认隐藏\n\n隐藏我的课程：默认隐藏\n\n隐藏免流量：默认隐藏\n\n隐藏工房：默认隐藏\n\n隐藏能量加油站：默认隐藏\n\n隐藏BW乐园：默认隐藏\n\n隐藏B萌投票：默认隐藏\n\n隐藏个性装扮：默认显示\n\n隐藏我的钱包：默认显示\n\n隐藏我的游戏中心：默认显示\n\n隐藏会员购订单：默认显示\n\n隐藏我的直播：默认显示\n\n隐藏必火推广：默认显示\n\n隐藏创作中心：默认显示\n\n隐藏社区中心：默认显示\n\n隐藏联系客服：默认显示\n\n隐藏听视频：默认显示\n\n隐藏未成年人守护：默认显示\n\n隐藏设置：默认显示\n\nCDN：auto 只提升同一媒体路径、由服务器提供且后台验证合格的完整地址；无可靠证据时保留原主地址；不接管媒体重试或快进请求、不拼接主机；off 关闭 CDN 改写，固定主机也只使用本次响应已有候选\n\n分流策略：DIRECT、PROXY 或 Shadowrocket 中已有的策略组名称\n\nPCDN策略：默认 DIRECT；可选择 REJECT，海外回国分流时也可填写同一个策略组\n\n网络档案：auto 在运行时支持时区分 Wi-Fi/蜂窝并只保存稳定标识 hash，不支持时回落共享 auto；也可手动命名隔离网络\n\n测速方式：cron 在后台匿名比较原主线路与实际备用线路，分别学习音视频；收到播放信息后的三分钟暂停测速；旧 nonblocking 映射为 cron，blocking 仅诊断，off 停止学习并只使用仍有效的既有测速结果\n\n重置令牌：更改令牌会安全清空一次已学习 CDN 状态；相同令牌不会重复重置\n\n测速间隔：稳定后每 2–72 小时测速；每十分钟检查一次是否到期，新网络首次最多六轮加快学习，之后遵守此间隔；近期播放时延后测速，初期测速会额外消耗流量；样本六小时有效\n\n切换阈值：当前线路健康时，挑战者的 TTFB/短段/持续吞吐综合分至少领先该百分比才切换；线路不健康时立即切换\n\n调试日志：仅排错时开启；日志不记录完整媒体 URL、签名或响应正文

[Rule]
DOMAIN-WILDCARD,*pcdn*.biliapi.net,{{{PCDN策略}}}
RULE-SET,https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/Bilibili.list?v=3.13.0,{{{分流策略}}}

[Script]
Bilibili CDN Background Benchmark = type=cron,cronexp=0 */10 * * * *,wake-system=1,timeout=45,engine=webview,script-path=https://raw.githubusercontent.com/STERILITZIA02/IOS_Bilibiliu_CDN_rewrite/main/dist/bilibili-cdn-benchmark.js?v=3.13.0,argument="{"cdn":"{{{CDN}}}","networkProfile":"{{{网络档案}}}","probeMode":"{{{测速方式}}}","resetToken":"{{{重置令牌}}}","intervalHours":{{{测速间隔}}},"switchThreshold":{{{切换阈值}}},"debug":{{{调试日志}}}}"
Bilibili Enhance Fresh UI = type=http-request,pattern=^https?:\/\/(?:(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/vip\/ads\/materials)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/vip\/ads\/material\/report)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/resource\/(?:top\/activity|patch\/tab(?:\/v2)?))|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/list)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/show)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/event\/list2)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/splash\/brand\/list)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/feed\/index)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/feed\/index\/story)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/feed\/index\/story\/cart)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/feed\/index\/relate\/story)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/search\/square)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/search(?:\/type)?)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/resource\/show\/tab\/v2)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/account\/mine(?:\/ipad)?)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/account\/myinfo)|(?:(?:app\.bilibili\.com|app\.biliapi\.net)(?::\d+)?\/x\/v2\/view)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/polymer\/web-dynamic\/v1\/feed\/all)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/pgc\/page\/(?:bangumi|cinema\/tab))|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/pgc\/page\/channel)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/web-interface\/(?:wbi\/)?index\/top\/feed\/rcmd)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/v2\/reply\/main)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/x\/vip\/web\/vip_center\/combine)|(?:(?:api\.bilibili\.com|api\.biliapi\.net)(?::\d+)?\/pgc\/activity\/deliver\/material\/receive)|(?:(?:api\.live\.bilibili\.com)(?::\d+)?\/xlive\/app-room\/v1\/index\/getInfoByRoom)|(?:(?:api\.live\.bilibili\.com)(?::\d+)?\/xlive\/app-room\/v1\/index\/getInfoByUser)|(?:(?:api\.live\.bilibili\.com)(?::\d+)?\/xlive\/app-interface\/v2\/index\/feed)|(?:(?:api\.live\.bilibili\.com)(?::\d+)?\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info)|(?:(?:line3-h5-mobile-api\.biligame\.com)(?::\d+)?\/game\/live\/large_card_material)|(?:(?:api\.vc\.bilibili\.com)(?::\d+)?\/search_svr\/v\d+\/Search\/recommend_words)|(?:(?:manga\.bilibili\.com)(?::\d+)?\/twirp\/comic\.v\d+\.Comic\/(?:Flash|ListFlash))|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.view\.v1\.View\/View)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.view\.v1\.View\/ViewProgress)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.view\.v1\.View\/RelatesFeed)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.view\.v1\.View\/TFInfo)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.viewunite\.v1\.View\/View)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.viewunite\.v1\.View\/ViewProgress)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.viewunite\.v1\.View\/PlayPause)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.viewunite\.v1\.View\/ViewEndPage)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.viewunite\.v1\.View\/RelatesFeed)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.viewunite\.v1\.View\/AIRelateAsync)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.mine\.v1\.Mine\/PubModule)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.mine\.v1\.Mine\/DeviceFeature)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.resource\.v1\.Module\/List)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.show\.v1\.Popular\/Index)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynVideo)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAllPersonal)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynVideoPersonal)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.community\.service\.dm\.v1\.DM\/DmView)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchByType)|(?:(?:app\.bilibili\.com|app\.biliapi\.net|grpc\.bilibili\.com|grpc\.biliapi\.net)(?::\d+)?\/bilibili\.app\